#include <iostream>
#include <thread>
#include <mutex>
using namespace std;

int cnt = 0;

mutex m;

void fun() {
    for (int i = 0; i < 100000; i++) {

        m.lock();       // Acquire lock

        cnt++;          // Critical Section

        m.unlock();     // Release lock
    }
}

int main() {
    thread t1(fun);
    thread t2(fun);

    t1.join();
    t2.join();

    cout << cnt << endl;
}
